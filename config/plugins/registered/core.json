{
  "schema_version": 1,
  "plugin": {
    "name": "core",
    "version": "1.0.0"
  },
  "packages": [
    {
      "subject_code": "NOTIFICATION",
      "version": "1.0.0",
      "description": "Prepare a bounded local notification.",
      "capability": "notify.send",
      "adapter": "local-notify",
      "required_fields": ["message"],
      "optional_fields": ["title"],
      "payload_rules": {
        "message": "body",
        "title": "TITLE"
      },
      "returns": ["status"],
      "permission_class": "bounded_local_output",
      "permission_shapes": ["once", "bounded_uses"]
    },
    {
      "subject_code": "EMAIL:DRAFT",
      "version": "1.0.0",
      "description": "Prepare a non-sent email draft for an adapter.",
      "capability": "email.draft",
      "adapter": "gmail",
      "required_fields": ["to", "subject", "body"],
      "optional_fields": ["cc", "bcc", "attachments"],
      "payload_rules": {
        "to": "TO",
        "subject": "SUBJECT",
        "body": "body",
        "cc": "CC",
        "bcc": "BCC",
        "attachments": "ATTACHMENTS"
      },
      "returns": ["draft_id", "status"],
      "permission_class": "nonpublic_composed_output",
      "permission_shapes": ["once", "project", "bounded_uses"],
      "enabled": true
    },
    {
      "subject_code": "MAIL:MARK_READ",
      "version": "1.0.0",
      "description": "Mark one exact mail message read through the configured adapter.",
      "capability": "mail.mark_read",
      "adapter": "gmail",
      "required_fields": ["message_id", "mailbox"],
      "optional_fields": [],
      "payload_rules": {"message_id": "MESSAGE-ID", "mailbox": "MAILBOX"},
      "returns": ["status"],
      "permission_class": "bounded_external_action",
      "permission_shapes": ["once", "bounded_uses", "until_revoked"],
      "enabled": true
    },
    {
      "subject_code": "MAIL:LABEL",
      "version": "1.0.0",
      "description": "Apply one explicit safe mail flag to one exact message.",
      "capability": "mail.label",
      "adapter": "gmail",
      "required_fields": ["message_id", "mailbox", "flag"],
      "optional_fields": [],
      "payload_rules": {"message_id": "MESSAGE-ID", "mailbox": "MAILBOX", "flag": "FLAG"},
      "returns": ["status"],
      "permission_class": "bounded_external_action",
      "permission_shapes": ["once", "bounded_uses", "until_revoked"],
      "enabled": true
    },
    {
      "subject_code": "MAIL:MOVE",
      "version": "1.0.0",
      "description": "Move one exact message between explicitly named mailboxes.",
      "capability": "mail.move",
      "adapter": "gmail",
      "required_fields": ["message_id", "from", "to"],
      "optional_fields": [],
      "payload_rules": {"message_id": "MESSAGE-ID", "from": "FROM", "to": "TO"},
      "returns": ["status"],
      "permission_class": "bounded_external_action",
      "permission_shapes": ["once"],
      "enabled": true
    },
    {
      "subject_code": "MAIL:DRAFT",
      "version": "1.0.0",
      "description": "Create a non-sent draft associated with one exact source message.",
      "capability": "mail.draft",
      "adapter": "gmail",
      "required_fields": ["message_id", "mailbox", "to", "subject", "body"],
      "optional_fields": [],
      "payload_rules": {"message_id": "MESSAGE-ID", "mailbox": "MAILBOX", "to": "TO", "subject": "SUBJECT", "body": "body"},
      "returns": ["status"],
      "permission_class": "nonpublic_composed_output",
      "permission_shapes": ["once", "bounded_uses", "until_revoked"],
      "enabled": true
    }
  ]
}
